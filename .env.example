# Copy this file to .env and fill in local credentials/contact details.
# .env is gitignored — never commit real keys or a personal email address.

# NCBI asks E-utilities clients to identify the software and a monitored
# contact. NCBI_API_KEY is optional unless the run exceeds the unauthenticated
# request rate. The fetcher fails before searching when NCBI_EMAIL is blank.
NCBI_TOOL=exposome_ehr_review
NCBI_EMAIL=your-monitored-address@example.org
# NCBI_API_KEY=

EXPOSOME_LLM_BASE_URL=https://mac-mini.tail5aee49.ts.net/v1
# Optional — the tailnet-internal endpoint above needs no key.
# Uncomment and fill in only when pointing at a key-requiring endpoint:
# EXPOSOME_LLM_API_KEY=
EXPOSOME_LLM_MODEL=ornith-1.5-35b
