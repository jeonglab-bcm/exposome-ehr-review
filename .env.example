# Copy this file to .env and fill in your Gemma endpoint key.
# .env is gitignored — never commit a real key.
#
# The pipeline works with ANY OpenAI-compatible endpoint.
#
# Option A — homelab server (default):
GEMMA_BASE_URL=https://llm.bioinfolder.com/v1
GEMMA_API_KEY=sk-unsloth-PLACEHOLDER
GEMMA_MODEL=gemma4-12b-qat-gguf
#
# Option B — local oMLX on this Mac (see docs/local-llm.md):
# GEMMA_BASE_URL=http://localhost:8000/v1
# GEMMA_API_KEY=no-key
# GEMMA_MODEL=Qwen3.6-35B-A3B-4bit
